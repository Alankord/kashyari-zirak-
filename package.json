{
  "name": "smart-pos",
  "version": "1.0.1",
  "description": "کاشێری زیرەک - SMART POS (ئۆفلاین)",
  "main": "main.js",
  "author": "Smart POS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.smartpos.app",
    "productName": "SmartPOS",
    "files": ["index.html", "main.js", "preload.js"],
    "publish": {
      "provider": "github",
      "owner": "Alankord",
      "repo": "kashyari-zirak-"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
